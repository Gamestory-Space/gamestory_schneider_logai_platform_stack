# Schneider-specific identity setup for the Schneider Logai platform stack.
#
# This file intentionally contains placeholders only. Copy it to a private env
# file for real Schneider values.

CUSTOMER_CODE=schneider
CUSTOMER_DISPLAY_NAME=Schneider Electric SSO

# Set this once Schneider confirms the protocol.
# Allowed values: oidc, saml
CUSTOMER_IDP_PROTOCOL=oidc
CUSTOMER_IDP_ALIAS=schneider-main

KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=gamestory-sso

# Local testing reuses the existing sample-ui client.
# Customer deployment should change this to the deployed Logai URL/client.
LOGAI_AUTH_CLIENT_ID=sample-ui
LOGAI_AUTH_CALLBACK_URL=http://sample.localhost:3000/auth/callback
LOGAI_AUTH_WEB_ORIGIN=http://sample.localhost:3000

# OIDC fields, if Schneider provides OIDC.
OIDC_ISSUER_URL=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_CLIENT_AUTH_METHOD=client_secret_post

# SAML fields, if Schneider provides SAML.
SAML_ENTITY_ID=
SAML_SSO_URL=
SAML_SIGNING_CERTIFICATE=
SAML_NAME_ID_FORMAT=email
SAML_METADATA_URL=

CLAIM_EMAIL=email
CLAIM_DISPLAY_NAME=name
CLAIM_GROUPS=groups
