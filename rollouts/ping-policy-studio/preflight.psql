\ir target.psql
BEGIN READ ONLY;
SET LOCAL statement_timeout='60s';
SELECT pg_catalog.set_config('search_path',pg_catalog.quote_ident(:'target_schema')||', pg_catalog',true);
SELECT current_database() AS database,current_user AS operator,current_schema() AS schema,
       current_setting('server_version') AS postgres_version;
SELECT c.relname AS existing_relation,c.relkind,pg_catalog.pg_get_userbyid(c.relowner) AS owner
 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
 WHERE n.nspname=current_schema() AND c.relkind IN ('r','p','v','m') ORDER BY c.relname;
SELECT table_name,column_name,udt_name,character_maximum_length,is_nullable,column_default
 FROM information_schema.columns WHERE table_schema=current_schema()
 AND table_name LIKE 'logai\_%' ESCAPE '\' ORDER BY table_name,ordinal_position;
SELECT c.relname AS table_name,k.conname,pg_catalog.pg_get_constraintdef(k.oid) AS definition
 FROM pg_catalog.pg_constraint k JOIN pg_catalog.pg_class c ON c.oid=k.conrelid
 JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
 WHERE n.nspname=current_schema() AND c.relname LIKE 'logai\_%' ESCAPE '\' ORDER BY c.relname,k.conname;
SELECT tablename,indexname,indexdef FROM pg_catalog.pg_indexes
 WHERE schemaname=current_schema() AND tablename LIKE 'logai\_%' ESCAPE '\' ORDER BY tablename,indexname;
SELECT pid,usename,application_name,state,xact_start,wait_event_type,wait_event
 FROM pg_catalog.pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid() ORDER BY xact_start NULLS LAST;
\ir minimum-shape.psql
SELECT format('SELECT backend,location_hash FROM %I.logai_policy_storage',current_schema())
 WHERE to_regclass(format('%I.logai_policy_storage',current_schema())) IS NOT NULL \gexec
-- Records/counts/fingerprints and a restored backup rehearsal are DBA evidence;
-- warehouse row contents and credentials are not printed by this inventory.
COMMIT;
